# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (MySQL via Prisma)
DATABASE_URL=mysql://root:password@localhost:3306/routesync

# Authentication (JWT)
JWT_ACCESS_SECRET=routesync_super_secret_jwt_access_token_key_2026!
JWT_REFRESH_SECRET=routesync_super_secret_jwt_refresh_token_key_2026!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Optional Services
ORS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@routesync.app
